# PostgreSQL usado pela API e pelos comandos Prisma.
# Ajuste usuário, senha e porta para seu PostgreSQL local.
DATABASE_URL="postgresql://futliga:futliga@localhost:5432/futliga?schema=public"

# API
PORT=3000
NODE_ENV=development
# Origens do frontend permitidas, separadas por vírgula.
CORS_ORIGIN=http://localhost:5173
APP_VERSION=1.0.0

# Frontend (variável pública, incorporada ao build do Vite)
VITE_API_URL=http://localhost:3000

# Reservado para a etapa de autenticação; ainda não é usado.
# JWT_SECRET=
