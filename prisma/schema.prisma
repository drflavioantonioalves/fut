generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  MASTER_ADMIN
}

enum OrganizationMemberRole {
  CHAMPIONSHIP_ADMIN
}

enum ChampionshipStatus {
  DRAFT
  SCHEDULED
  LIVE
  FINISHED
  ARCHIVED
  PENDING_DELETION
  DELETED
}

enum MatchStatus {
  SCHEDULED
  FIRST_HALF
  HALF_TIME
  SECOND_HALF
  FINISHED
}

enum EventType {
  GOAL
  YELLOW
  BLUE
  RED
  SUBSTITUTION
  SYSTEM
}

enum RosterRole {
  STARTER
  RESERVE
}

model User {
  id                      String               @id @default(cuid())
  name                    String
  email                   String               @unique
  passwordHash            String
  role                    PlatformRole?
  active                  Boolean              @default(true)
  organizationMemberships OrganizationMember[]
  sessions                Session[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  active        Boolean              @default(true)
  members       OrganizationMember[]
  championships Championship[]
  teams         Team[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationMemberRole
  active         Boolean                @default(true)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Championship {
  id             String             @id @default(cuid())
  name           String
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status         ChampionshipStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  phases         Phase[]
  teams          Team[]
  matches        Match[]
  awards         Award[]
  sponsors       Sponsor[]
  comments       Comment[]
  votes          Vote[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Required as the target of Team's composite foreign key, which enforces
  // that a team cannot point at a championship from another organization.
  @@unique([id, organizationId])
  @@index([organizationId])
}

model Phase {
  id             String       @id @default(cuid())
  name           String
  type           String
  order          Int
  championshipId String
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Restrict)
  matches        Match[]

  @@unique([id, championshipId])
  @@index([championshipId])
}

model Team {
  id             String        @id @default(cuid())
  name           String
  championshipId String?
  organizationId String?
  championship   Championship? @relation(fields: [championshipId, organizationId], references: [id, organizationId], onDelete: NoAction)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  players        Player[]
  homeMatches    Match[]       @relation("HomeTeam")
  awayMatches    Match[]       @relation("AwayTeam")

  // These composite keys let Match and Championship enforce tenant ownership
  // with foreign keys instead of relying on application-side checks.
  @@unique([id, championshipId])
  @@index([championshipId])
  @@index([organizationId])
}

model Player {
  id          String  @id @default(cuid())
  name        String
  shirtNumber Int?
  position    String?
  teamId      String
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Restrict)
}

model Match {
  id             String        @id @default(cuid())
  championshipId String
  championship   Championship  @relation(fields: [championshipId], references: [id], onDelete: Restrict)
  phaseId        String?
  phase          Phase?        @relation(fields: [phaseId, championshipId], references: [id, championshipId], onDelete: NoAction)
  homeTeamId     String
  homeTeam       Team          @relation("HomeTeam", fields: [homeTeamId, championshipId], references: [id, championshipId], onDelete: Restrict)
  awayTeamId     String
  awayTeam       Team          @relation("AwayTeam", fields: [awayTeamId, championshipId], references: [id, championshipId], onDelete: Restrict)
  venue          String?
  scheduledAt    DateTime?
  status         MatchStatus   @default(SCHEDULED)
  homeScore      Int           @default(0)
  awayScore      Int           @default(0)
  startedAt      DateTime?
  secondHalfAt   DateTime?
  finishedAt     DateTime?
  events         MatchEvent[]
  roster         MatchRoster[]
  createdAt      DateTime      @default(now())

  @@index([championshipId])
}

model MatchRoster {
  id          String     @id @default(cuid())
  matchId     String
  playerId    String?
  playerName  String
  shirtNumber Int?
  position    String?
  role        RosterRole
  manual      Boolean    @default(false)
  match       Match      @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@index([matchId])
}

model MatchEvent {
  id         String    @id @default(cuid())
  matchId    String
  type       EventType
  teamId     String?
  playerId   String?
  playerName String?
  minute     Int
  detail     String?
  createdAt  DateTime  @default(now())
  match      Match     @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@index([matchId])
}

model Award {
  id             String       @id @default(cuid())
  championshipId String
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Restrict)
  name           String
  icon           String?
  winnerType     String
  winnerName     String?
  teamName       String?
  statistic      String?
  description    String?
  displayOrder   Int          @default(0)
  visible        Boolean      @default(true)

  @@index([championshipId])
}

model Sponsor {
  id             String        @id @default(cuid())
  championshipId String?
  championship   Championship? @relation(fields: [championshipId], references: [id], onDelete: SetNull)
  name           String
  title          String?
  description    String?
  imageUrl       String?
  websiteUrl     String?
  active         Boolean       @default(true)

  @@index([championshipId])
}

model Comment {
  id             String       @id @default(cuid())
  championshipId String
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Restrict)
  nickname       String
  text           String
  hidden         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([championshipId])
}

model Vote {
  id             String       @id @default(cuid())
  championshipId String
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Restrict)
  spectatorId    String
  playerId       String
  createdAt      DateTime     @default(now())

  @@unique([championshipId, spectatorId])
}
